GET {{baseUrl}}/api/products/create/
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzU4ODE2MDk3LCJpYXQiOjE3NTg3OTQ0OTcsImp0aSI6IjlkMjkyMDIyNjZlODRjN2RiZWFmNDgyMmE1ODRkOTJhIiwidXNlcl9pZCI6IjgxZGU2YjhjLTA3OTAtNGJlMS1hZTAyLWNkMjYyMThjYWMyYSJ9.-FqsBLGjjQhELAxlQMjZaeEZHl5hM9U-x_K-ECVQGJE


###update product
PUT {{baseUrl}}/api/products/<uuid>/

###single product view
GET {{baseUrl}}/api/products/<uuid>/


#-------------------------------- product list by customer


### List all products (public)
GET {{baseUrl}}/api/products/public/
Accept: application/json



### Get product detail by UUID (public)
# Replace <PRODUCT_ID> with actual UUID of the product
GET {{baseUrl}}/api/products/public/32628e53-acb0-45d4-9c29-cbbbe59a596a/
Accept: application/json


###get related product using product id
GET {{baseUrl}}/api/products/40541852-b045-4bd1-8abf-d3e007bc184c/related/


# -------------------------------cart section------------------------

### Add product
POST {{baseUrl}}/api/cart/add/5f08cb6b-dd91-45d2-844e-6fd79524def7/
Content-Type: application/json
X-Cart-Token: eed00d21-c25a-4b5e-943f-91f407a46819


###

### Get cart items
GET {{baseUrl}}/api/cart/
Content-Type: application/json
X-Cart-Token: eed00d21-c25a-4b5e-943f-91f407a46819

###

### Update quantity of a cart item(id from cart item model)
PATCH {{baseUrl}}/api/cart/item/1e93077d-9596-4d88-a8b6-335074ba0313/update/
Content-Type: application/json

{
  "quantity": 5
}

###

### Remove item from cart
DELETE {{baseUrl}}/api/cart/item/6699d774-b8fa-4a96-8e84-938b35cbae06/delete/
Content-Type: application/json


### ----------------------------inquiry section---------------------------------------------------------------

### 1. Create Inquiry (unauthenticated user, pass cart items)
POST {{baseUrl}}/api/inquiries/create/
Content-Type: application/json

{
  "cart_id": "3f0ff7e9-defe-4a0c-aa3e-a0050dbe3b86",
  "product_ids": [
    "25a6e9bd-7cd5-465c-91b5-c86f8915f236",
    "32628e53-acb0-45d4-9c29-cbbbe59a596a"
  ],
  "first_name": "John",
  "last_name": "Doe",
  "company_name": "ACME Corp",
  "email": "john.doe@example.com",
  "phone": "+1234567890",
  "address": "123 Main Street",
  "country": "USA",
  "state": "CA",
  "delivery_location": "Warehouse 1",
  "description": "Need more info about these products"
}


